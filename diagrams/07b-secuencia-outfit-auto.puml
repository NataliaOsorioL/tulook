@startuml
'
' Diagrama de Secuencia - Creación de Outfit Automático
' Algoritmo de generación con scoring, jitter y reintentos
'

!theme plain
skinparam backgroundColor #FEFEFE
skinparam participant {
  BorderColor #2D4059
  BackgroundColor #EAEAEA
  FontColor #1A1A2E
  FontSize 11
}
skinparam actor {
  BorderColor #1A1A2E
  FontColor #1A1A2E
  FontSize 13
}
skinparam arrow {
  Color #555555
  FontSize 9
}

title "Flujo 4b: Creación de Outfit — Automático"
caption "Algoritmo de generación con 2 intentos + scoring heurístico"

actor "Usuario" as user
participant "OutfitScreen" as out
participant "AuthContext" as aCtx
participant "auth.service" as auth
participant "outfit.service" as osvc
participant "outfit-generator-v2" as gen
database "Firebase\nFirestore" as fb

== Inicio de generación automática ==

user -> out : Tapa "Generar Automático"
activate out

out -> out : handleAutoGenerate()

' === Pre-check ===
out -> gen : canGenerateOutfit(allGarments)
activate gen
note right
  Requisitos:
  · ≥ 2 prendas total
  · (TOP+BOTTOM) o DRESS
  · SHOES + ACCESSORY
end note
gen --> out : { allowed, reason }
deactivate gen

alt Pre-check falla
  out -> user : Alert("No se pudo generar:\n" + translateOutfitError(reason))
  note right : Termina el flujo
  deactivate out

else Pre-check exitoso
  note right of out
    userId obtenido de
    useAuth() (contexto)
  end note

  out -> osvc : getRecentOutfitGarmentIds(userId)
  activate osvc
  osvc -> fb : query("daily_outfits",\nwhere user_id, assigned_date >= 14d)
  fb --> osvc : DailyOutfit[]
  osvc -> fb : query("outfit_garments",\nwhere outfit_id in batch)
  loop Lotes de 10 outfits
    fb --> osvc : OutfitGarment[]
  end
  osvc --> out : Set<string> (recentGarmentIds)
  deactivate osvc

  out -> out : Determinar preferredMode
  note right
    Alterna respecto al último
    modo usado para evitar
    repetir dress/top-bottom
  end note

  ' === Intento 1 ===
  group Intento 1 — Modo preferido
    out -> gen : selectDailyOutfitGarments(\ngarments, recentIds, temp,\nexcludeIds, preferredMode)
    activate gen

    gen -> gen : groupByCategory(garments)
    gen -> gen : Modo DRESS o TOP-BOTTOM\nsegún disponibilidad

    group Pick por categoría
      gen -> gen : pickBody(mode)
      note right
        DRESS: 1 vestido
        TOP-BOTTOM: top + bottom
        Cada uno con
        computeGarmentScore()
        + random jitter (±3 pts)
      end note

      gen -> gen : pickRequired(SHOES)
      gen -> gen : pickRequired(ACCESSORY)

      alt Falta alguna categoría
        gen -> gen : Retorna { reason }
      end
    end

    gen --> out : { garments[], name, description, outfitMode }
    deactivate gen

    out -> gen : validateOutfit(result) [post-check]
    activate gen
    note right
      Verifica duplicados,
      conflictos dress+top/bottom,
      categorías faltantes
    end note
    gen --> out : { valid, errors[] }
    deactivate gen
  end

  ' === Intento 2 (si falla el 1) ===
  alt Post-check falla (Intento 1)
    out -> out : Modo opuesto\n(alternar dress ↔ top-bottom)

    group Intento 2 — Modo opuesto
      out -> gen : selectDailyOutfitGarments(\ngarments, recentIds, temp,\nexcludeIds, modoOpuesto)
      activate gen
      gen -> gen : (misma lógica que intento 1)
      gen --> out : resultado
      deactivate gen

      out -> gen : validateOutfit(result)
      activate gen
      gen --> out : { valid, errors[] }
      deactivate gen
    end

    alt Ambos intentos fallaron
      out -> user : Alert("No se pudo generar")
      deactivate out
    end
  end

  ' === Éxito ===
  group Generación exitosa
    out -> out : Construir newSelection desde\nresult.garments
    out -> out : setSelectedById(newSelection)
    out -> out : setHasAutoGenerated(true)
    out -> out : lastModeRef.current =\nresult.outfitMode
  end

end

out --> user : Preview actualizada\ncon outfit generado
deactivate out

legend right
  == Algoritmo ==
  computeGarmentScore():
  · recently used → penaliza
  · forgotten (>180d) → bonifica
  · low usage (≤3) → bonifica
  · favorite → bonifica
  · season mismatch → penaliza
  · random jitter → ±3

  == Reintentos ==
  Si el modo preferido falla,
  se reintenta con el modo
  opuesto exactamente una vez.
end legend

@enduml
