@startuml
'
' Diagrama de Secuencia - Inicialización de la App
' Basado en App.js + AuthContext + user.bootstrap.service + seed.js
'

!theme plain
skinparam backgroundColor #FEFEFE
skinparam participant {
  BorderColor #2D4059
  BackgroundColor #EAEAEA
  FontColor #1A1A2E
  FontSize 11
}
skinparam actor {
  BorderColor #1A1A2E
  FontColor #1A1A2E
  FontSize 13
}
skinparam arrow {
  Color #555555
  FontSize 9
}
skinparam note {
  BorderColor #E6B800
  BackgroundColor #FFF8DC
  FontSize 10
}
skinparam lifeline {
  BorderColor #2D4059
}

title "Flujo 1: Inicialización de la Aplicación"

actor "Usuario" as user
participant "App.js" as app
participant "AuthContext" as aCtx
participant "ThemeContext" as tctx
participant "auth.service" as auth
participant "user.bootstrap\n.service" as boot
participant "user.service" as usvc
participant "seed.js" as seed
participant "garment.service" as gsvc
database "Firebase\nFirestore" as fb
boundary "Firebase\nAuth" as fba

== Render inicial ==

user -> app : Abre la app
activate app

app -> aCtx : <AuthProvider>
activate aCtx
aCtx -> aCtx : useEffect → onAuthChanged(fba)
activate fba
fba --> aCtx : null (no autenticado)
deactivate fba
aCtx -> app : { isAuthenticated: false }
deactivate aCtx

app -> tctx : <ThemeProvider>
activate tctx

alt No autenticado
  app -> app : Renderiza LoginScreen (Guest Stack)
  app -> user : Muestra pantalla de inicio de sesión
  deactivate app

  user -> app : Ingresa email + contraseña
  activate app
  app -> aCtx : login(email, password)
  activate aCtx
  aCtx -> auth : login(email, password)
  activate auth
  auth -> fba : signInWithEmailAndPassword()
  fba --> auth : UserCredential
  auth --> aCtx : user
  deactivate auth
  deactivate aCtx
  deactivate app

else Autenticado por persistencia
  note right of aCtx
    Firebase Auth restaura
    sesión previa automáticamente
  end note
end

== Post-autenticación ==

aCtx -> aCtx : useEffect → user cambió
aCtx -> boot : initializeAppForUser(userId, email)
activate boot

boot -> usvc : getUserProfile(userId)
activate usvc
usvc -> fb : getDoc("users/{uid}")
fb --> usvc : snapshot | null

alt Perfil no existe
  usvc -> fb : setDoc("users/{uid}",\n{ name, email, ... })
  fb --> usvc : ok
  usvc --> boot : perfil creado
else Perfil existe
  usvc --> boot : UserProfile
end
deactivate usvc

boot -> boot : migrateLegacyUserData(userId)
note right
  Migra datos desde
  seed-user-001 a la
  nueva cuenta si
  aplica (solo una vez)
end note

boot -> seed : seedForUser(userId)
activate seed

seed -> gsvc : getGarmentsByUser(userId)
activate gsvc
gsvc -> fb : query("garments",\nwhere user_id == userId, limit 1)
fb --> gsvc : [] (vacío)
gsvc --> seed : []
deactivate gsvc

alt Usuario sin prendas (seed)
  loop 9 veces (SEED_GARMENTS)
    seed -> gsvc : createGarment(userId, template)
    activate gsvc
    gsvc -> fb : addDoc("garments",\n{ user_id, name, category, ... })
    fb --> gsvc : DocumentReference
    gsvc --> seed : Garment
    deactivate gsvc
  end
else Ya tiene prendas (omitido)
  note right : seed.skipped = true
end

seed --> boot : { skipped, garments[] }
deactivate seed

boot -> seed : validateFirestoreData(userId)
activate seed
seed -> gsvc : getGarmentsByUser(userId)
activate gsvc
gsvc -> fb : query("garments",\nwhere user_id == userId)
fb --> gsvc : Garment[]
gsvc --> seed : Garment[]
deactivate gsvc

seed -> seed : Verificar categorías\n(top, bottom, shoes, dress, accessory)

seed --> boot : ValidationCheck[]
deactivate seed

boot --> aCtx : init completado
deactivate boot

== Carga de tema ==

app -> tctx : <ThemeProvider> (re-render)
activate tctx

tctx -> auth : ensureSignedIn()
activate auth
auth --> tctx : userId (de getCurrentUser())
deactivate auth

tctx -> usvc : getUserProfile(userId)
activate usvc
usvc -> fb : getDoc("users/{uid}")
fb --> usvc : { theme, ... }
usvc --> tctx : UserProfile
deactivate usvc

tctx -> tctx : setThemeMode(resolved)\n(Listen system theme changes)

tctx --> app : ThemeProvider listo
deactivate tctx

note right of app
  RootStack con
  BottomTabNavigator
  (5 tabs) renderizado
end note

app -> user : Muestra HomeScreen
deactivate app

@enduml
