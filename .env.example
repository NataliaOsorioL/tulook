# === GitHub Configuración ===
# Repositorio público para almacenar imágenes de prendas.
# Las imágenes se guardan en garments/{userId}/{timestamp}.jpg
# y se sirven desde raw.githubusercontent.com (público, sin token).

# === OBLIGATORIO: GitHub Token ===
# Crear en: GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens
# Permiso requerido: Contents > Read and Write
# Repositorio: NataliaOsorioL/tulook
# Formato: github_pat_...
EXPO_PUBLIC_GITHUB_TOKEN=github_pat_tu_token_aqui

# === OPCIONAL (defaults ya configurados) ===
# Solo necesitas cambiar estos si usas otro repo/branch.
EXPO_PUBLIC_GITHUB_OWNER=NataliaOsorioL
EXPO_PUBLIC_GITHUB_REPO=tulook
